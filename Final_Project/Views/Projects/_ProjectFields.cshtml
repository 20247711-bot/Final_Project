@model Final_Project.Models.ProjectFormViewModel
<div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="CourseId" class="form-label">Course</label>
<select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-select dark-input"><option value="">Choose a course</option></select><span asp-validation-for="CourseId" class="text-danger"></span><label asp-for="Title" class="form-label mt-3">Project title</label>
<input asp-for="Title" class="form-control dark-input" /><span asp-validation-for="Title" class="text-danger"></span><label asp-for="Description" class="form-label mt-3"></label><textarea asp-for="Description" rows="4" class="form-control dark-input"></textarea><label asp-for="VideoUrl" class="form-label mt-3">YouTube URL (optional)</label>
<input asp-for="VideoUrl" class="form-control dark-input" placeholder="https://youtu.be/..." /><label asp-for="ImageUrls" class="form-label mt-3"></label><textarea asp-for="ImageUrls" rows="5" class="form-control dark-input" placeholder="https://example.com/image1.jpg&#10;https://example.com/image2.jpg"></textarea><small class="muted">Paste one direct image URL per line. These are saved in the project_image table.</small>
