@model Portfolio.Models.Course

<h1>Delete Course</h1>

<h3>Are you sure you want to delete this course?</h3>

<div>
    <p><strong>Course Code:</strong> @Model.CourseCode</p>
    <p><strong>Course Name:</strong> @Model.CourseName</p>
    <p><strong>Description:</strong> @Model.Description</p>
    <p><strong>Course Year:</strong> @Model.CourseYear</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.CourseId" />

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>