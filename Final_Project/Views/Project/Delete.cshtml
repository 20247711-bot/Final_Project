@model Portfolio.Models.Project

<h1>Delete Project</h1>

<h3>Are you sure you want to delete this project?</h3>

<div>
    <p><strong>Project ID:</strong> @Model.ProjectId</p>
    <p><strong>Course ID:</strong> @Model.CourseId</p>
    <p><strong>Title:</strong> @Model.Title</p>
    <p><strong>Description:</strong> @Model.Description</p>
    <p><strong>Video URL:</strong> @Model.VideoUrl</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.ProjectId" />

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>