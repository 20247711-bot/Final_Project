@model List<Portfolio.Models.Project>

<h1>Projects</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Project</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Course ID</th>
            <th>Title</th>
            <th>Description</th>
            <th>Video</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var project in Model)
        {
            <tr>
                <td>@project.CourseId</td>
                <td>@project.Title</td>
                <td>@project.Description</td>
                <td>
                    @if (!string.IsNullOrEmpty(project.VideoUrl))
                    {
                        <a href="@project.VideoUrl" target="_blank">View Video</a>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@project.ProjectId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@project.ProjectId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>